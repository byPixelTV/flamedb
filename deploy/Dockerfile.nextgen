FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=unknown
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/byPixelTV/flamedb/internal/util.GitCommit=${VERSION}" -o /flamedb ./cmd/flamedb

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache ca-certificates tzdata && addgroup -S flame && adduser -S -G flame flame
COPY --from=build /flamedb /usr/local/bin/flamedb
USER flame
EXPOSE 7777 9090
ENTRYPOINT ["flamedb"]
CMD ["/etc/flamedb/config.yml"]
