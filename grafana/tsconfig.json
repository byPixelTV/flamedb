{
  "compilerOptions": {
    "target": "ES2020", "lib": ["DOM", "ES2020"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
