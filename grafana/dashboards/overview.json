        "type": "flamedb-flamedb-datasource",
        "uid": "flamedb"
      },
      "description": "Mean of the selected regions per time bucket. This panel does not show a sum of gauges across regions.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "flamedb-flamedb-datasource",
            "uid": "flamedb"
          },
          "metrics": [
            "players"
          ],
          "filters": [],
          "mode": "timeseries",
          "aggregation": "AVG",
          "interval": "10s",
          "groupBy": [
            "server"
          ],
          "legend": "{{metric}} · {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#339bd1"
          },
          "thresholds": {
